<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Статус-бар всегда скрыт, а его цвет (если система его всё же
         покажет) совпадает с фоном приложения. -->
    <style name="Theme.Predictor" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:statusBarColor">#0F1115</item>
        <item name="android:navigationBarColor">#0F1115</item>
        <item name="android:windowBackground">#0F1115</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
